# Copy to .env.production and populate through an approved secret manager.
POSTGRES_DB=rizvi_foms
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@db:5432/rizvi_foms

OIDC_ISSUER=https://identity.example/issuer
OIDC_AUDIENCE=rizvi-foms-api
OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json

# Production environment controls
ENVIRONMENT=production
LOG_LEVEL=INFO
