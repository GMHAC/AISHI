[Unit]
Description=RIZVI FOMS API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rizvi-foms
EnvironmentFile=/etc/rizvi-foms/environment
ExecStart=/opt/rizvi-foms/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
