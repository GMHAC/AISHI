NODE_ENV=production
PORT=8080
APP_VERSION=2026.08.27-scale-ready
JWT_SECRET=GENERATE_A_64_PLUS_CHARACTER_RANDOM_SECRET
CORS_ORIGIN=https://YOUR-FIREBASE-DOMAIN.web.app
# Cloud Storage: files go directly from Android/iPhone/Windows browser to the bucket.
GCS_BUCKET=YOUR-RIZVI-DOCUMENT-BUCKET
GOOGLE_CLOUD_PROJECT=YOUR-GCP-PROJECT-ID
PUBSUB_DOCUMENT_TOPIC=rizvi-document-ingest
# 5 GiB default maximum object size; lower it if your policy requires.
MAX_UPLOAD_BYTES=5368709120
SIGNED_URL_TTL_MS=900000
API_RATE_LIMIT_PER_MINUTE=1200
# For Cloud Run use Secret Manager / service identity rather than committing keys.
